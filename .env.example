# Copy this file to .env and fill in real values for local development.
# Never commit .env with real secrets.

# Everything below is optional for local development and preview builds.
# A Vercel PRODUCTION build fails unless RESEND_API_KEY, LEAD_FROM_EMAIL,
# TURNSTILE_SECRET_KEY and PUBLIC_TURNSTILE_SITE_KEY are all set.

# Resend (https://resend.com) — emails leads from the forms and chatbot.
# Unset locally: /api/lead validates the lead and logs a notice (no PII).
# Unset in production: /api/lead returns 503 so visitors are told to call.
RESEND_API_KEY=
# Destination inbox for lead notifications. Defaults to the business email
# in src/data/business.ts if unset.
LEAD_TO_EMAIL=
# Verified "from" address in your Resend account/domain. Required in production.
LEAD_FROM_EMAIL=

# Cloudflare Turnstile (bot/spam protection) for the contact form and quick
# lead form. Get both keys from dash.cloudflare.com -> Turnstile -> Add
# widget manually.
# - PUBLIC_TURNSTILE_SITE_KEY is public/client-exposed (rendered into the
#   page to load the widget) — safe to ship in client JS.
# - TURNSTILE_SECRET_KEY must stay server-only. Never expose it to the
#   client or commit a real value.
# In production, POST /api/lead FAILS CLOSED: if TURNSTILE_SECRET_KEY is
# missing, or a submission arrives with a missing/invalid token, the request
# is rejected. The only bypass is local dev / preview deploys with no
# TURNSTILE_SECRET_KEY configured, so contributors aren't forced to
# provision a Turnstile widget just to run the app locally.
# Every source is verified, including the chatbot. For local testing,
# Cloudflare's always-pass test keys work:
#   site key 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=
PUBLIC_TURNSTILE_SITE_KEY=

# Upstash Redis (https://upstash.com) REST credentials for a rate limit that
# holds across Vercel's serverless instances. Unset = per-instance in-memory
# limit only. Recommended for production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Analytics/tracking. Leave unset to skip. Set GTM *or* GA4, not both (load
# GA4 through GTM). IDs are format-checked (GTM-XXXX / G-XXXX) before render.
# Lead conversions fire as `generate_lead` only after the API confirms the
# lead; tel: clicks fire `phone_call_click`.
PUBLIC_GA4_ID=
PUBLIC_GTM_ID=
PUBLIC_CALLRAIL_COMPANY_ID=
PUBLIC_CALLRAIL_SCRIPT_ID=
