---
/**
 * Premium interactive Colorado service-area map.
 *
 * Geometry: real Colorado state boundary (US Census cartographic boundary
 * data via the public us-atlas states-10m TopoJSON), projected at build
 * time to a static SVG path — see scripts/generate-service-area-map.mjs
 * and src/data/serviceAreaMap.generated.ts. The coverage-area "blob", the
 * decorative I-25/I-70 corridor lines, and the interstate shield anchor
 * points are ALSO computed at build time in that same script, from the
 * real projected marker coordinates (a padded, smoothed convex hull) —
 * nothing here is hand-drawn or eyeballed. No mapping library, no
 * geography payload ships to the browser; the SVG paths are just markup.
 *
 * Markers come from the canonical serviceAreas dataset (src/data/business.ts)
 * via the generated projection file, so this never drifts from the
 * Service Area page, footer, or homepage strip.
 *
 * Two visual variants, one shared marker/tooltip/data engine:
 *  - `variant="full"` (default): the full poster layout used on the
 *    Service Area page — map + legend + compass + shields + "COLORADO"
 *    watermark, paired with a "Communities We Serve" side panel and a
 *    bottom stat/CTA strip.
 *  - `variant="compact"`: a smaller single-card treatment (map only, with
 *    a trimmed legend) sized for the homepage, where a full poster layout
 *    would overwhelm the page's pacing. Still built from the same
 *    projectedMarkers/coverageAreaPath data — no separate hardcoded city
 *    list.
 *
 * Interaction is vanilla JS (see the inline <script> below): hover/focus a
 * marker to reveal a tooltip with a real link when a location page exists,
 * or a "Request Service" CTA when it doesn't. Denver is rendered as a tiny
 * muted geographic reference point only — never styled or labeled as a
 * service marker.
 */
import { MapPin, Phone } from 'lucide-react';
import { business, serviceAreas } from '../../data/business';
import { cityPages } from '../../data/cityPages';
import {
  MAP_VIEW_BOX,
  coloradoPath,
  coverageAreaPath,
  i25Path,
  i70Path,
  roadShields,
  projectedMarkers,
  projectedReferences
} from '../../data/serviceAreaMap.generated';

interface Props {
  variant?: 'full' | 'compact';
}
const { variant = 'full' } = Astro.props;
const isCompact = variant === 'compact';

const pagedSlugs = new Set(cityPages.map((c) => c.slug));

const primary = projectedMarkers.find((m) => m.type === 'primary')!;
const surrounding = projectedMarkers.filter((m) => m.type === 'surrounding');

/** Colorado Springs sits in a genuinely dense real-world cluster with
 * Cascade, Manitou Springs, Woodland Park, and Monument/Palmer Lake all
 * within a few map-miles — the default "label centered above the dot"
 * placement collides badly there. Rather than a general label-placement
 * algorithm, these few markers get a manually tuned offset + anchor so
 * the label reads outward, away from the cluster center. Every other
 * marker uses the default above-center placement. Precise identification
 * for every marker is still available via the tooltip (hover/focus) and
 * the crawlable community list below/beside the map. The compact variant
 * hides labels entirely below its own breakpoint (see CSS) since there
 * isn't room to apply overrides at that smaller scale. */
const LABEL_OVERRIDES: Record<string, { dx: number; dy: number; anchor: 'start' | 'middle' | 'end' }> = {
  cascade: { dx: -16, dy: 4, anchor: 'end' },
  'manitou-springs': { dx: -12, dy: 14, anchor: 'end' },
  'woodland-park': { dx: -10, dy: -6, anchor: 'end' },
  monument: { dx: 10, dy: -10, anchor: 'start' },
  'palmer-lake': { dx: -10, dy: -2, anchor: 'end' },
  security: { dx: 12, dy: -4, anchor: 'start' },
  widefield: { dx: 12, dy: 12, anchor: 'start' },
  fountain: { dx: -10, dy: 4, anchor: 'end' },
  'black-forest': { dx: -10, dy: -4, anchor: 'end' },
  falcon: { dx: 10, dy: 14, anchor: 'start' },
  peyton: { dx: 10, dy: -8, anchor: 'start' }
};

function labelFor(slug: string) {
  return LABEL_OVERRIDES[slug] ?? { dx: 0, dy: -12, anchor: 'middle' as const };
}

const trustTiles = [
  { icon: 'shield', title: 'Licensed & Insured', copy: 'Your home is in safe hands.' },
  { icon: 'users', title: 'Local Experts', copy: `We know ${business.addressLocality} & the surrounding areas.` },
  { icon: 'clock', title: '24/7 Emergency Service', copy: "We're here when you need us most." },
  { icon: 'thumb', title: '100% Satisfaction Guaranteed', copy: 'Quality work. Honest pricing. Every time.' }
];
---

<div class:list={['service-area-map-wrap', isCompact && 'is-compact']} data-reveal>
  <div class:list={['map-poster-grid', !isCompact && 'map-poster-grid--full']}>
    <!-- ============ MAP CARD ============ -->
    <div class="service-area-map card-elevated relative overflow-hidden bg-white p-4 sm:p-6">
      {
        !isCompact && (
          <div class="map-legend" aria-hidden="true">
            <p class="map-legend-item">
              <span class="map-legend-dot map-legend-dot--primary" />
              <span>
                <strong>Primary Market</strong>
                <span class="map-legend-sub">{business.addressLocality}</span>
              </span>
            </p>
            <p class="map-legend-item">
              <span class="map-legend-dot map-legend-dot--surrounding" />
              <span>
                <strong>Communities We Serve</strong>
              </span>
            </p>
            <p class="map-legend-item">
              <span class="map-legend-dot map-legend-dot--reference" />
              <span>
                <strong>Major Reference City</strong>
              </span>
            </p>
          </div>
        )
      }

      {
        !isCompact && (
          <div class="map-compass" aria-hidden="true">
            <svg viewBox="0 0 40 40" class="size-9">
              <circle cx="20" cy="20" r="18" fill="white" stroke="var(--color-navy-200)" stroke-width="1.5" />
              <path d="M20 4 L24 20 L20 17 L16 20 Z" fill="var(--color-orange-600)" />
              <path d="M20 36 L16 20 L20 23 L24 20 Z" fill="var(--color-navy-700)" />
              <path d="M4 20 L20 18 L20 22 Z" fill="var(--color-navy-300)" />
              <path d="M36 20 L20 22 L20 18 Z" fill="var(--color-navy-300)" />
              <text x="20" y="12" text-anchor="middle" class="map-compass-n">
                N
              </text>
            </svg>
          </div>
        )
      }

      <svg
        class="map-svg h-auto w-full"
        viewBox={MAP_VIEW_BOX}
        role="img"
        aria-labelledby="service-map-title service-map-desc"
        preserveAspectRatio="xMidYMid meet"
      >
        <title id="service-map-title">Map of the Affordable Plumbing, Heat &amp; Electrical service area in Colorado</title>
        <desc id="service-map-desc">
          A map of Colorado showing Colorado Springs as the primary service market, with {surrounding.length} verified
          surrounding communities marked, a shaded coverage area around the service corridor, and Denver shown only as a
          muted geographic reference point.
        </desc>

        <defs>
          <radialGradient id="map-surface" cx="30%" cy="15%" r="95%">
            <stop offset="0%" stop-color="var(--color-mist-100)"></stop>
            <stop offset="55%" stop-color="#eef1ea"></stop>
            <stop offset="100%" stop-color="#e4e8de"></stop>
          </radialGradient>
          <linearGradient id="map-terrain-1" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="var(--color-navy-200)" stop-opacity="0.35"></stop>
            <stop offset="100%" stop-color="var(--color-navy-300)" stop-opacity="0.12"></stop>
          </linearGradient>
          <linearGradient id="map-terrain-2" x1="0%" y1="0%" x2="100%" y2="60%">
            <stop offset="0%" stop-color="var(--color-ink-300)" stop-opacity="0.25"></stop>
            <stop offset="100%" stop-color="var(--color-ink-200)" stop-opacity="0.08"></stop>
          </linearGradient>
          <radialGradient id="map-coverage" cx="45%" cy="45%" r="65%">
            <stop offset="0%" stop-color="var(--color-orange-300)" stop-opacity="0.55"></stop>
            <stop offset="100%" stop-color="var(--color-orange-400)" stop-opacity="0.28"></stop>
          </radialGradient>
          <filter id="marker-shadow" x="-50%" y="-50%" width="200%" height="200%">
            <feDropShadow dx="0" dy="1.5" stdDeviation="1.5" flood-color="#0a1830" flood-opacity="0.25"></feDropShadow>
          </filter>
        </defs>

        <rect x="0" y="0" width="800" height="620" fill="url(#map-surface)"></rect>

        <!-- Stylized terrain backdrop: soft layered navy/gray shapes suggesting
             mountain massing west of the Front Range corridor. Purely
             decorative illustration (NOT a literal/photographic relief) —
             kept lightweight and on-brand, drawn once at build time as
             static shapes with no runtime cost. -->
        <g class="map-terrain" aria-hidden="true">
          <path
            d="M-40,180 L60,90 L140,150 L210,70 L290,160 L250,250 L120,300 L-40,260 Z"
            fill="url(#map-terrain-1)"></path>
          <path
            d="M-40,320 L90,260 L180,330 L260,290 L300,380 L180,460 L40,430 L-40,470 Z"
            fill="url(#map-terrain-2)"></path>
          <path
            d="M-40,480 L80,430 L170,490 L230,460 L300,540 L200,620 L-40,620 Z"
            fill="url(#map-terrain-1)"></path>
        </g>

        <!-- "COLORADO" watermark label in the empty western portion of the
             state, matching the reference poster's muted background text. -->
        <text x="185" y="360" class="map-watermark" text-anchor="middle" aria-hidden="true">COLORADO</text>

        <!-- Colorado outline: real state boundary, projected at build time -->
        <path
          class="map-outline"
          d={coloradoPath}
          fill="none"
          stroke="var(--color-navy-300)"
          stroke-width="2"
          stroke-linejoin="round"></path>

        <!-- Decorative interstate corridor lines: I-25 (north-south through
             the service corridor) and I-70 (east-west, well north, near
             Denver). Waypoints computed at build time from the real
             projected marker/reference coordinates — decorative context,
             not survey-accurate highway traces. -->
        <path d={i70Path} class="map-highway" fill="none" aria-hidden="true"></path>
        <path d={i25Path} class="map-highway" fill="none" aria-hidden="true"></path>

        <!-- Coverage-area "blob": a padded, smoothed convex hull around the
             real projected markers (see scripts/generate-service-area-map.mjs).
             Communicates the service footprint at a glance without ever
             implying statewide coverage — it sits well inside the Colorado
             outline and only covers the actual service corridor. -->
        <path class="map-coverage" d={coverageAreaPath} fill="url(#map-coverage)" stroke="var(--color-orange-500)"
          stroke-width="1.5" stroke-opacity="0.5"></path>

        <!-- Interstate shield icons: simple SVG silhouettes (not literal
             FHWA artwork), navy/orange, anchored along the corridor lines. -->
        {
          roadShields.map((s) => (
            <g class="map-shield" transform={`translate(${s.x} ${s.y})`} aria-hidden="true">
              <path
                d="M0,-9 L8,-6 L8,2 C8,7 4,10 0,12 C-4,10 -8,7 -8,2 L-8,-6 Z"
                fill="var(--color-navy-800)"
                stroke="white"
                stroke-width="1.2"
              />
              <text y="3.5" text-anchor="middle" class="map-shield-text">
                {s.interstate.replace('I-', '')}
              </text>
            </g>
          ))
        }

        <!-- Geographic reference points (e.g. Denver) — tiny, muted, clearly not service markers -->
        {
          projectedReferences.map((ref) => (
            <g class="map-reference" transform={`translate(${ref.x} ${ref.y})`} aria-hidden="true">
              <circle r="3.5" fill="var(--color-navy-800)" />
              <circle r="3.5" fill="none" stroke="white" stroke-width="1" />
              <text x="7" y="3.5" class="map-reference-label">
                {ref.name}
                {!isCompact && <tspan class="map-reference-sublabel"> (reference)</tspan>}
              </text>
            </g>
          ))
        }

        <!-- Surrounding service-community markers -->
        {
          surrounding.map((m, i) => {
            const hasPage = pagedSlugs.has(m.slug);
            const href = hasPage ? `/service-area/${m.slug}/` : undefined;
            const label = labelFor(m.slug);
            return (
              <g
                class="map-marker map-marker--surrounding"
                data-marker
                data-name={m.name}
                data-href={href ?? ''}
                data-has-page={hasPage ? '1' : '0'}
                transform={`translate(${m.x} ${m.y})`}
                tabindex="0"
                role="button"
                aria-label={`${m.name}, verified service community${hasPage ? ' — view service details' : ' — request service'}`}
              >
                {/* Position (translate) lives on this outer <g>; the inner <g>
                    below carries the CSS enter/hover animation. SVG's
                    `transform` attribute and a CSS `transform` on the SAME
                    element don't compose — an animated CSS transform would
                    silently replace the translate and reposition every marker
                    to the SVG origin. Splitting them into two nested <g>s keeps
                    position and animation independent. */}
                <g class="map-marker-inner" style={`--enter-delay:${80 + i * 45}ms`}>
                  <circle r="7" fill="var(--color-orange-500)" filter="url(#marker-shadow)" />
                  <circle r="7" fill="none" stroke="white" stroke-width="1.5" />
                  <text x={label.dx} y={label.dy} class="map-marker-label" text-anchor={label.anchor}>
                    {m.name}
                  </text>
                </g>
              </g>
            );
          })
        }

        <!-- Primary market marker: Colorado Springs, drawn last so it sits on top -->
        <g
          class="map-marker map-marker--primary"
          data-marker
          data-name={primary.name}
          data-href="/service-area/"
          data-has-page="0"
          data-primary="1"
          transform={`translate(${primary.x} ${primary.y})`}
          tabindex="0"
          role="button"
          aria-label={`${primary.name}, primary service market`}
        >
          <g class="map-marker-inner">
            <circle class="map-pulse" r="10" fill="var(--color-orange-500)" opacity="0.35"></circle>
            <circle r="11" fill="var(--color-orange-600)" filter="url(#marker-shadow)"></circle>
            <circle r="11" fill="none" stroke="white" stroke-width="2"></circle>
            <text y="-18" class="map-marker-label map-marker-label--primary" text-anchor="middle">
              {primary.name}
            </text>
            <text y="-6" class="map-marker-sublabel" text-anchor="middle"> Primary Market </text>
          </g>
        </g>
      </svg>

      <!-- Tooltip: positioned via JS on hover/focus. Kept outside the SVG so it
           can hold real interactive HTML (a real link or button). -->
      <div id={`map-tooltip-${variant}`} class="map-tooltip" role="tooltip" hidden>
        <p class="map-tooltip-city"></p>
        <p class="map-tooltip-business">{business.name}</p>
        <p class="map-tooltip-status">Service available in this area.</p>
        <a class="map-tooltip-cta map-tooltip-cta--view" href="#">
          View Area
          <MapPin className="size-3.5" aria-hidden="true" />
        </a>
        <a class="map-tooltip-cta map-tooltip-cta--request" href="/contact-us/">
          Request Service
          <MapPin className="size-3.5" aria-hidden="true" />
        </a>
      </div>

      {
        isCompact && (
          <p class="text-ink-400 mt-4 flex items-center gap-1.5 text-center text-xs sm:justify-center">
            <Phone className="size-3.5 shrink-0" aria-hidden="true" />
            Don&rsquo;t see your town? Call {business.hotline.display} — there&rsquo;s a good chance we still cover
            you.
          </p>
        )
      }
    </div>

    {
      /* Communities side panel: real crawlable HTML, kept outside the SVG
         entirely — this is the primary a11y/SEO redundancy for the visual
         map. */
      !isCompact && (
        <aside class="communities-panel card-elevated overflow-hidden bg-white p-0" aria-label="Communities we serve">
          <div class="communities-panel-header">
            <MapPin className="size-4 shrink-0" aria-hidden="true" />
            <h3>Communities We Serve</h3>
          </div>
          <ul class="communities-panel-list">
            {serviceAreas.map((area) => (
              <li>
                <MapPin className="communities-panel-pin" aria-hidden="true" />
                <div>
                  <p class="communities-panel-name">{area.name}</p>
                  <p class="communities-panel-blurb">{area.blurb}</p>
                </div>
              </li>
            ))}
          </ul>
        </aside>
      )
    }
  </div>

  {
    /* Bottom stat/CTA strip */
    !isCompact && (
      <div class="trust-strip">
        {trustTiles.map((tile) => (
          <div class="trust-tile">
            <span class="trust-tile-icon" aria-hidden="true">
              {tile.icon === 'shield' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 2 L20 6 V12 C20 17 16.5 20.5 12 22 C7.5 20.5 4 17 4 12 V6 Z" />
                  <path d="M8.5 12 L11 14.5 L15.5 9.5" />
                </svg>
              )}
              {tile.icon === 'users' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="9" cy="8" r="3" />
                  <path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6" />
                  <circle cx="17" cy="9" r="2.5" />
                  <path d="M15.5 14a4.5 4.5 0 0 1 5.5 4.4" />
                </svg>
              )}
              {tile.icon === 'clock' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="9" />
                  <path d="M12 7v5l3.5 2" />
                </svg>
              )}
              {tile.icon === 'thumb' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M7 11v9H4a1 1 0 0 1-1-1v-7a1 1 0 0 1 1-1z" />
                  <path d="M7 11l3-7a2 2 0 0 1 2 2v4h6.5a1.5 1.5 0 0 1 1.45 1.87l-1.5 6A1.5 1.5 0 0 1 17 19H9" />
                </svg>
              )}
            </span>
            <div>
              <p class="trust-tile-title">{tile.title}</p>
              <p class="trust-tile-copy">{tile.copy}</p>
            </div>
          </div>
        ))}

        <div class="trust-cta">
          <p class="trust-cta-title">Need Service Today?</p>
          <p class="trust-cta-copy">Call or request online in minutes.</p>
          <a href={`tel:${business.hotline.tel}`} class="trust-cta-button">
            <Phone className="size-4 shrink-0" aria-hidden="true" />
            {business.hotline.display}
          </a>
        </div>
      </div>
    )
  }
</div>

<style>
  .map-poster-grid {
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 1024px) {
    .map-poster-grid--full {
      grid-template-columns: minmax(0, 1fr) 320px;
      align-items: start;
    }
  }

  /* Scoped to the map's own <svg> via .map-svg specifically — NOT a bare
   * `:global(svg)` selector, which would also match the unrelated lucide
   * <Phone>/<MapPin> icon <svg> elements rendered elsewhere in this same
   * component and blow them up to the map's own pixel dimensions. */
  .map-svg {
    /* Matches the 800x620 viewBox exactly so the CSS box and the SVG's
     * internal coordinate system always scale together. A `max-height`
     * combined with a definite `width: 100%` breaks aspect-ratio (the
     * browser clamps height but doesn't reduce width to match), which
     * desyncs every marker's hit-test position from what's visually
     * rendered. Capping `max-width` instead of `max-height` keeps a single
     * definite axis, so `aspect-ratio` reliably derives the other. */
    aspect-ratio: 800 / 620;
    width: 100%;
    max-width: 826px; /* 640px tall at this component's viewBox ratio */
    height: auto;
    display: block;
    margin-inline: auto;
  }

  .is-compact .map-svg {
    max-width: 100%;
  }

  .map-outline {
    opacity: 0;
    animation: map-fade-in 0.7s ease-out 0.05s both;
  }

  .map-terrain {
    opacity: 0;
    animation: map-fade-in 0.8s ease-out 0s both;
  }

  .map-watermark {
    font-family: var(--font-display);
    font-size: 34px;
    font-weight: 800;
    letter-spacing: 0.08em;
    fill: var(--color-ink-300);
    opacity: 0.45;
  }

  .is-compact .map-watermark {
    font-size: 26px;
  }

  .map-coverage {
    opacity: 0;
    animation: map-fade-in 0.7s ease-out 0.3s both;
  }

  .map-highway {
    stroke: var(--color-navy-300);
    stroke-width: 2.5;
    stroke-dasharray: 1 7;
    stroke-linecap: round;
    opacity: 0;
    animation: map-fade-in 0.6s ease-out 0.5s both;
  }

  .map-shield {
    opacity: 0;
    animation: map-fade-in 0.5s ease-out 0.85s both;
  }

  .map-shield-text {
    font-family: var(--font-display);
    font-size: 7px;
    font-weight: 800;
    fill: white;
  }

  .map-reference {
    opacity: 0;
    animation: map-fade-in 0.5s ease-out 0.7s both;
  }

  .map-reference-label {
    font-family: var(--font-body);
    font-size: 10px;
    fill: var(--color-ink-400);
  }

  .map-reference-sublabel {
    fill: var(--color-ink-300);
    font-style: italic;
  }

  .map-marker {
    cursor: pointer;
  }

  /* The inner <g> carries the enter animation + hover/focus scale — kept
     separate from the outer <g>'s positional `transform="translate(...)"`
     attribute so the CSS animation's `transform` never overwrites it. */
  .map-marker-inner {
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    animation: marker-enter 0.5s cubic-bezier(0.16, 1, 0.3, 1) var(--enter-delay, 0.6s) both;
  }

  .map-marker--primary .map-marker-inner {
    animation-delay: 0.75s;
  }

  .map-marker-label {
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 600;
    fill: var(--color-navy-900);
    paint-order: stroke;
    stroke: white;
    stroke-width: 3px;
    stroke-linejoin: round;
  }

  .map-marker-label--primary {
    font-size: 14px;
    font-weight: 800;
  }

  .map-marker-sublabel {
    font-family: var(--font-display);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.06em;
    fill: var(--color-orange-600);
    text-transform: uppercase;
    paint-order: stroke;
    stroke: white;
    stroke-width: 3px;
  }

  .map-marker:hover .map-marker-inner,
  .map-marker:focus-visible .map-marker-inner {
    transform: scale(1.18);
  }

  .map-marker--surrounding .map-marker-inner {
    transition: transform 0.2s ease-out;
  }

  .map-marker--primary:hover .map-marker-inner,
  .map-marker--primary:focus-visible .map-marker-inner {
    transform: scale(1.08);
  }

  .map-marker:focus-visible {
    outline: none;
  }

  .map-marker:focus-visible .map-marker-inner circle:nth-child(2) {
    stroke: var(--color-orange-600);
    stroke-width: 3px;
  }

  .map-pulse {
    transform-box: fill-box;
    transform-origin: center;
    animation: pulse-ring 2.6s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  @keyframes map-fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes marker-enter {
    from {
      opacity: 0;
      transform: scale(0.4);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .map-outline,
    .map-terrain,
    .map-coverage,
    .map-highway,
    .map-shield,
    .map-reference,
