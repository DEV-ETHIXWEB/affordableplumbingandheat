---
/**
 * Premium interactive Colorado service-area map.
 *
 * The map surface is an illustrated raster map
 * (src/assets/images/service-area/colorado-service-area-map.webp) which
 * already carries the terrain shading, county lines, rivers, interstate
 * shields, compass rose, legend, and every city label as artwork. It is
 * served through Astro's <Image> pipeline, so responsive srcsets and
 * further optimisation happen at build time.
 *
 * Interactivity is layered ON TOP of that artwork as absolutely-positioned
 * hotspots — one per drawn marker — using percentage coordinates measured
 * from the artwork itself (see src/data/serviceAreaMapHotspots.ts for how
 * those were derived and why Cascade has no hotspot). Percentages mean the
 * hotspots stay locked to their pixels at every rendered size.
 *
 * Names/links for those hotspots still come from the canonical serviceAreas
 * dataset (src/data/business.ts) + cityPages, so labels and link targets
 * never drift from the Service Area page, footer, or homepage strip.
 *
 * Two visual variants, one shared hotspot/tooltip/data engine:
 *  - `variant="full"` (default): the full poster layout used on the
 *    Service Area page — the map artwork paired with a "Communities We
 *    Serve" side panel and a bottom stat/CTA strip.
 *  - `variant="compact"`: a smaller single-card treatment (map only) sized
 *    for the homepage, where the full poster layout would overwhelm the
 *    page's pacing. Same artwork and hotspot data — no separate hardcoded
 *    city list.
 *
 * Interaction is vanilla JS (see the inline <script> below): hover/focus a
 * hotspot to reveal a tooltip with a real link when a location page exists,
 * or a "Request Service" CTA when it doesn't. The crawlable "Communities We
 * Serve" list is real HTML outside the image — it, not the artwork, is the
 * accessible/indexable source of truth for coverage.
 */
import { Image } from 'astro:assets';
import { MapPin, Phone } from 'lucide-react';
import { business, serviceAreas } from '../../data/business';
import { cityPages } from '../../data/cityPages';
import mapArtwork from '../../assets/images/service-area/colorado-service-area-map.webp';
import {
  MAP_IMAGE_HEIGHT,
  MAP_IMAGE_WIDTH,
  primaryHotspot,
  surroundingHotspots
} from '../../data/serviceAreaMapHotspots';

interface Props {
  variant?: 'full' | 'compact';
}
const { variant = 'full' } = Astro.props;
const isCompact = variant === 'compact';

const pagedSlugs = new Set(cityPages.map((c) => c.slug));
const areaBySlug = new Map(serviceAreas.map((a) => [a.slug, a]));

/** Join a measured artwork hotspot to its canonical dataset entry, so the
 * accessible name and link target always come from src/data/business.ts
 * rather than being restated here. */
function hotspotEntry(spot: { slug: string; xPct: number; yPct: number }) {
  const area = areaBySlug.get(spot.slug);
  const hasPage = pagedSlugs.has(spot.slug);
  return {
    ...spot,
    name: area?.name ?? spot.slug,
    hasPage,
    href: hasPage ? `/service-area/${spot.slug}/` : ''
  };
}

const primary = hotspotEntry(primaryHotspot);
const surrounding = surroundingHotspots.map(hotspotEntry);

const trustTiles = [
  { icon: 'shield', title: 'Licensed & Insured', copy: 'Your home is in safe hands.' },
  { icon: 'users', title: 'Local Experts', copy: `We know ${business.addressLocality} & the surrounding areas.` },
  { icon: 'clock', title: '24/7 Emergency Service', copy: "We're here when you need us most." },
  { icon: 'thumb', title: '100% Satisfaction Guaranteed', copy: 'Quality work. Honest pricing. Every time.' }
];
---

<div class:list={['service-area-map-wrap', isCompact && 'is-compact']} data-reveal>
  <div class:list={['map-poster-grid', !isCompact && 'map-poster-grid--full']}>
    <!-- ============ MAP CARD ============ -->
    <div class="service-area-map card-elevated relative overflow-hidden bg-white p-4 sm:p-6">
      <!-- The map surface itself is illustrated artwork: terrain, county
           lines, rivers, interstate shields, the compass rose, the legend,
           and every city label are drawn into the image. Interactivity is
           layered over it below. Marked aria-hidden + empty alt because the
           "Communities We Serve" list (real HTML, outside the image) is the
           accessible source of truth for coverage — a long alt string
           restating 15 towns would just duplicate it noisily. -->
      <div class="map-figure">
        <Image
          src={mapArtwork}
          alt=""
          aria-hidden="true"
          widths={[640, 1024, 1536]}
          sizes={isCompact ? '(min-width: 1024px) 640px, 100vw' : '(min-width: 1024px) 1024px, 100vw'}
          quality="high"
          format="webp"
          class="map-image"
          loading={isCompact ? 'lazy' : 'eager'}
          width={MAP_IMAGE_WIDTH}
          height={MAP_IMAGE_HEIGHT}
        />

        <!-- Interactive hotspots, positioned as a % of the artwork so they
             stay locked to their painted marker at any rendered size. Each
             one sits over a dot the artwork already draws; the visible ring
             only appears on hover/focus so it never fights the illustration. -->
        <div class="map-hotspots">
          {
            surrounding.map((m, i) => (
              <button
                type="button"
                class="map-hotspot map-hotspot--surrounding"
                data-marker
                data-name={m.name}
                data-href={m.href}
                data-has-page={m.hasPage ? '1' : '0'}
                style={`left:${m.xPct}%; top:${m.yPct}%; --enter-delay:${80 + i * 45}ms`}
                aria-label={`${m.name}, verified service community${m.hasPage ? ' — view service details' : ' — request service'}`}
              >
                <span class="map-hotspot-ring" aria-hidden="true" />
              </button>
            ))
          }

          <button
            type="button"
            class="map-hotspot map-hotspot--primary"
            data-marker
            data-name={primary.name}
            data-href="/service-area/"
            data-has-page="0"
            data-primary="1"
            style={`left:${primary.xPct}%; top:${primary.yPct}%`}
            aria-label={`${primary.name}, primary service market`}
          >
            <span class="map-hotspot-pulse" aria-hidden="true"></span>
            <span class="map-hotspot-ring" aria-hidden="true"></span>
          </button>
        </div>
      </div>


      <!-- Tooltip: positioned via JS on hover/focus. Kept outside the SVG so it
           can hold real interactive HTML (a real link or button). -->
      <div id={`map-tooltip-${variant}`} class="map-tooltip" role="tooltip" hidden>
        <p class="map-tooltip-city"></p>
        <p class="map-tooltip-business">{business.name}</p>
        <p class="map-tooltip-status">Service available in this area.</p>
        <a class="map-tooltip-cta map-tooltip-cta--view" href="#">
          View Area
          <MapPin className="size-3.5" aria-hidden="true" />
        </a>
        <a class="map-tooltip-cta map-tooltip-cta--request" href="/contact-us/">
          Request Service
          <MapPin className="size-3.5" aria-hidden="true" />
        </a>
      </div>

      {
        isCompact && (
          <p class="text-ink-400 mt-4 flex items-center gap-1.5 text-center text-xs sm:justify-center">
            <Phone className="size-3.5 shrink-0" aria-hidden="true" />
            Don&rsquo;t see your town? Call {business.hotline.display} — there&rsquo;s a good chance we still cover
            you.
          </p>
        )
      }
    </div>

    {
      /* Communities side panel: real crawlable HTML, kept outside the SVG
         entirely — this is the primary a11y/SEO redundancy for the visual
         map. */
      !isCompact && (
        <aside class="communities-panel card-elevated overflow-hidden bg-white p-0" aria-label="Communities we serve">
          <div class="communities-panel-header">
            <MapPin className="size-4 shrink-0" aria-hidden="true" />
            <h3>Communities We Serve</h3>
          </div>
          <ul class="communities-panel-list">
            {serviceAreas.map((area) => (
              <li>
                <MapPin className="communities-panel-pin" aria-hidden="true" />
                <div>
                  <p class="communities-panel-name">{area.name}</p>
                  <p class="communities-panel-blurb">{area.blurb}</p>
                </div>
              </li>
            ))}
          </ul>
        </aside>
      )
    }
  </div>

  {
    /* Bottom stat/CTA strip */
    !isCompact && (
      <div class="trust-strip">
        {trustTiles.map((tile) => (
          <div class="trust-tile">
            <span class="trust-tile-icon" aria-hidden="true">
              {tile.icon === 'shield' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 2 L20 6 V12 C20 17 16.5 20.5 12 22 C7.5 20.5 4 17 4 12 V6 Z" />
                  <path d="M8.5 12 L11 14.5 L15.5 9.5" />
                </svg>
              )}
              {tile.icon === 'users' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="9" cy="8" r="3" />
                  <path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6" />
                  <circle cx="17" cy="9" r="2.5" />
                  <path d="M15.5 14a4.5 4.5 0 0 1 5.5 4.4" />
                </svg>
              )}
              {tile.icon === 'clock' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="9" />
                  <path d="M12 7v5l3.5 2" />
                </svg>
              )}
              {tile.icon === 'thumb' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M7 11v9H4a1 1 0 0 1-1-1v-7a1 1 0 0 1 1-1z" />
                  <path d="M7 11l3-7a2 2 0 0 1 2 2v4h6.5a1.5 1.5 0 0 1 1.45 1.87l-1.5 6A1.5 1.5 0 0 1 17 19H9" />
                </svg>
              )}
            </span>
            <div>
              <p class="trust-tile-title">{tile.title}</p>
              <p class="trust-tile-copy">{tile.copy}</p>
            </div>
          </div>
        ))}

        <div class="trust-cta">
          <p class="trust-cta-title">Need Service Today?</p>
          <p class="trust-cta-copy">Call or request online in minutes.</p>
          <a href={`tel:${business.hotline.tel}`} class="trust-cta-button">
            <Phone className="size-4 shrink-0" aria-hidden="true" />
            {business.hotline.display}
          </a>
        </div>
      </div>
    )
  }
</div>

<style>
  .map-poster-grid {
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 1024px) {
    .map-poster-grid--full {
      grid-template-columns: minmax(0, 1fr) 320px;
      align-items: start;
    }
  }

  /* ---- Illustrated map surface ---- */

  .map-figure {
    /* Establishes the positioning context for the percentage-placed
     * hotspots, and locks the box to the artwork's intrinsic ratio so
     * those percentages always resolve against the same shape the
     * hotspots were measured from. */
    position: relative;
    width: 100%;
    max-width: 1024px;
    margin-inline: auto;
    aspect-ratio: 1024 / 678;
    border-radius: 1rem;
    overflow: hidden;
  }

  .map-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .map-hotspots {
    position: absolute;
    inset: 0;
  }

  /* Each hotspot sits centred on the marker the artwork already paints, so
   * it stays invisible until hovered/focused — the illustration supplies
   * the visual dot, this supplies the hit target and the affordance. */
  .map-hotspot {
    position: absolute;
    transform: translate(-50%, -50%);
    width: 30px;
    height: 30px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: transparent;
    cursor: pointer;
    display: grid;
    place-items: center;
  }

  .map-hotspot--primary {
    width: 42px;
    height: 42px;
  }

  .map-hotspot-ring {
    width: 100%;
    height: 100%;
    border-radius: 999px;
    border: 2px solid var(--color-orange-600);
    opacity: 0;
    transform: scale(0.6);
    transition:
      opacity 0.18s ease-out,
      transform 0.18s ease-out;
    box-shadow: 0 0 0 4px rgb(236 87 19 / 0.16);
  }

  .map-hotspot:hover .map-hotspot-ring,
  .map-hotspot:focus-visible .map-hotspot-ring {
    opacity: 1;
    transform: scale(1);
  }

  .map-hotspot:focus-visible {
    outline: none;
  }

  .map-hotspot:focus-visible .map-hotspot-ring {
    border-width: 3px;
    box-shadow: 0 0 0 5px rgb(236 87 19 / 0.28);
  }

  /* Subtle attention pulse on the primary market only. */
  .map-hotspot-pulse {
    position: absolute;
    inset: 0;
    border-radius: 999px;
    background: var(--color-orange-500);
    opacity: 0.28;
    animation: hotspot-pulse 2.6s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  @keyframes hotspot-pulse {
    0%,
    100% {
      transform: scale(0.75);
      opacity: 0.3;
    }
    50% {
      transform: scale(1.15);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .map-hotspot-pulse {
      animation: none !important;
      opacity: 0 !important;
    }
    .map-hotspot-ring {
      transition: none !important;
    }
  }

  /* Touch/coarse pointers get no hover state, so show a faint persistent
   * ring to signal the markers are tappable. */
  @media (hover: none) {
    .map-hotspot-ring {
      opacity: 0.5;
      transform: scale(0.85);
    }
  }


  .map-tooltip {
    position: absolute;
    z-index: 20;
    max-width: 240px;
    border-radius: 14px;
    border: 1px solid var(--color-ink-100);
    background: white;
    padding: 12px 14px;
    box-shadow:
      0 1px 2px rgba(10, 24, 48, 0.06),
      0 12px 28px -8px rgba(10, 24, 48, 0.22);
    /* Always interactive: both tooltip CTAs ("View Area" and "Request
     * Service") are real links a keyboard/mouse user can activate. */
    pointer-events: auto;
  }

  .map-tooltip-city {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 14px;
    color: var(--color-navy-900);
    margin: 0;
  }

  .map-tooltip-business {
    font-size: 11px;
    color: var(--color-ink-500);
    margin: 2px 0 0;
  }

  .map-tooltip-status {
    font-size: 12px;
    color: var(--color-ink-700);
    margin: 6px 0 0;
  }

  .map-tooltip-cta {
    display: none;
    align-items: center;
    gap: 5px;
    margin-top: 8px;
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 700;
    color: var(--color-orange-600);
  }

  .map-tooltip-cta--active {
    display: inline-flex;
  }

  /* ---- Communities side panel ---- */
  .communities-panel {
    display: flex;
    flex-direction: column;
    max-height: 100%;
  }

  .communities-panel-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--color-navy-900);
    color: white;
    padding: 0.9rem 1.1rem;
  }

  .communities-panel-header h3 {
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .communities-panel-list {
    display: flex;
    flex-direction: column;
    max-height: 640px;
    overflow-y: auto;
  }

  .communities-panel-list li {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    padding: 0.7rem 1.1rem;
    border-bottom: 1px solid var(--color-ink-100);
  }

  .communities-panel-list li:last-child {
    border-bottom: none;
  }

  .communities-panel-pin {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    margin-top: 2px;
    color: var(--color-orange-500);
  }

  .communities-panel-name {
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-navy-900);
  }

  .communities-panel-blurb {
    font-size: 0.75rem;
    line-height: 1.4;
    color: var(--color-ink-500);
    margin-top: 0.1rem;
  }

  /* ---- Bottom trust/CTA strip ---- */
  .trust-strip {
    margin-top: 1.5rem;
    display: grid;
    gap: 1px;
    background: var(--color-ink-100);
    border: 1px solid var(--color-ink-100);
    border-radius: 1.25rem;
    overflow: hidden;
    box-shadow: var(--shadow-card);
    grid-template-columns: 1fr;
  }

  @media (min-width: 768px) {
    .trust-strip {
      grid-template-columns: repeat(4, 1fr) 1.1fr;
    }
  }

  .trust-tile {
    background: white;
    padding: 1.1rem 1.2rem;
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .trust-tile-icon {
    flex-shrink: 0;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--color-orange-50);
    color: var(--color-orange-600);
  }

  .trust-tile-icon svg {
    width: 1.15rem;
    height: 1.15rem;
  }

  .trust-tile-title {
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-navy-900);
  }

  .trust-tile-copy {
    font-size: 0.75rem;
    color: var(--color-ink-500);
    margin-top: 0.15rem;
    line-height: 1.4;
  }

  .trust-cta {
    background: var(--color-navy-900);
    color: white;
    padding: 1.1rem 1.2rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.5rem;
  }

  .trust-cta-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.95rem;
  }

  .trust-cta-copy {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.65);
  }

  .trust-cta-button {
    margin-top: 0.25rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border-radius: 999px;
    background: var(--color-orange-600);
    color: white;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.85rem;
    padding: 0.6rem 1rem;
    transition: background-color 0.2s ease;
  }

  .trust-cta-button:hover {
    background: var(--color-orange-700);
  }
</style>

<script>
  // Vanilla JS marker interaction: hover/focus shows a tooltip with either a
  // real "View Area" link (only when a location page exists) or a
  // "Request Service" link. No runtime mapping library — this just wires
  // up the static SVG already rendered above. Runs once per map instance
  // on the page (the homepage compact map and the service-area full map
  // never render together, but this is written to be safe if they ever
  // do — each `.service-area-map` root is wired independently).
  function initServiceAreaMap(root: HTMLElement) {
    const tooltip = root.querySelector<HTMLElement>('.map-tooltip');
    if (!tooltip) return;

    const cityEl = tooltip.querySelector<HTMLElement>('.map-tooltip-city');
    const viewCta = tooltip.querySelector<HTMLAnchorElement>('.map-tooltip-cta--view');
    const requestCta = tooltip.querySelector<HTMLAnchorElement>('.map-tooltip-cta--request');
    const markers = root.querySelectorAll<HTMLButtonElement>('[data-marker]');

    let hideTimeout: number | undefined;

    function showTooltip(marker: HTMLButtonElement) {
      window.clearTimeout(hideTimeout);
      const name = marker.dataset.name ?? '';
      const href = marker.dataset.href ?? '';
      const hasPage = marker.dataset.hasPage === '1';

      if (cityEl) cityEl.textContent = name;

      if (hasPage && href) {
        viewCta?.setAttribute('href', href);
        viewCta?.classList.add('map-tooltip-cta--active');
        requestCta?.classList.remove('map-tooltip-cta--active');
      } else {
        viewCta?.classList.remove('map-tooltip-cta--active');
        requestCta?.classList.add('map-tooltip-cta--active');
      }

      // Measure against the map artwork's own box. NOT `root.querySelector('svg')`,
      // which would now match the first lucide icon <svg> in the card (the
      // map surface is an <img>, not an SVG) and clamp the tooltip to a
      // 14px-wide icon.
      const figure = root.querySelector<HTMLElement>('.map-figure');
      if (!figure) return;
      const svgRect = figure.getBoundingClientRect();
      const rootRect = root.getBoundingClientRect();
      const pt = marker.getBoundingClientRect();

      const left = pt.left - rootRect.left + pt.width / 2;
      const top = pt.top - rootRect.top;

      const tooltipEl = tooltip!;
      tooltipEl.hidden = false;

      // Position above the marker with enough clearance that the tooltip
      // box never overlaps the marker's own hit area (which would block
      // re-hovering it or an adjacent marker). If there isn't enough room
      // above (marker near the top of the card), place it below instead.
      const tooltipWidth = 240;
      const tooltipHeight = 132;
      const markerClearance = 22;
      let x = left - tooltipWidth / 2;
      x = Math.max(8, Math.min(x, svgRect.width - tooltipWidth - 8));

      const spaceAbove = top;
      let y: number;
      if (spaceAbove >= tooltipHeight + markerClearance) {
        y = top - tooltipHeight - markerClearance / 2;
      } else {
        y = top + markerClearance + 14;
      }

      tooltipEl.style.left = `${x}px`;
      tooltipEl.style.top = `${Math.max(0, y)}px`;
    }

    function hideTooltip(delay = 120) {
      window.clearTimeout(hideTimeout);
      hideTimeout = window.setTimeout(() => {
        tooltip!.hidden = true;
      }, delay);
    }

    markers.forEach((marker) => {
      marker.addEventListener('mouseenter', () => showTooltip(marker));
      marker.addEventListener('mouseleave', () => hideTooltip());
      marker.addEventListener('focus', () => showTooltip(marker));
      marker.addEventListener('blur', () => hideTooltip(0));
      marker.addEventListener('click', () => {
        const href = marker.dataset.href;
        if (href) window.location.href = href;
        else window.location.href = '/contact-us/';
      });
      marker.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          const href = marker.dataset.href;
          window.location.href = href || '/contact-us/';
        }
      });
    });

    tooltip.addEventListener('mouseenter', () => window.clearTimeout(hideTimeout));
    tooltip.addEventListener('mouseleave', () => hideTooltip());
  }

  function initAllServiceAreaMaps() {
    document.querySelectorAll<HTMLElement>('.service-area-map').forEach(initServiceAreaMap);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAllServiceAreaMaps);
  } else {
    initAllServiceAreaMaps();
  }
</script>
