---
import { Image } from 'astro:assets';
import { Check } from 'lucide-react';
import Container from '../ui/Container.astro';
import heroImage from '../../assets/images/hero/castle-rock-aerial.jpg';

const points = [
  'Available 24/7',
  'Licensed & Insured',
  'Plumbing',
  'Electrical',
  'HVAC',
  'Sewer Repair',
  'Water Heaters',
  'Drain Cleaning'
];
---

<section class="relative overflow-hidden bg-navy-900 py-16">
  <div class="absolute inset-0" aria-hidden="true">
    <Image src={heroImage} alt="" width={1600} height={500} quality="high" class="h-full w-full object-cover opacity-25" loading="lazy" />
    <div class="from-navy-950/95 via-navy-900/90 to-navy-950/95 absolute inset-0 bg-gradient-to-r"></div>
  </div>
  <Container class="relative">
    <ul class="mx-auto grid max-w-4xl grid-cols-2 gap-x-10 gap-y-4 sm:grid-cols-2" data-reveal>
      {
        points.map((p) => (
          <li class="flex items-center gap-3 text-base font-semibold text-white sm:text-lg">
            <span class="grid size-6 shrink-0 place-items-center rounded-full bg-orange-500/20 text-orange-400">
              <Check className="size-4" aria-hidden="true" strokeWidth={3} />
            </span>
            {p}
          </li>
        ))
      }
    </ul>
  </Container>
</section>
