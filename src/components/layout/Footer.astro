---
import { Phone, Mail, MapPin, Clock, ArrowRight } from 'lucide-react';
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import SocialIcon from '../ui/SocialIcon.astro';
import { business, serviceAreas } from '../../data/business';
import { services, categoryMeta, type ServiceCategory } from '../../data/services';
import { cityPages } from '../../data/cityPages';
import logo from '../../assets/images/brand/logo.png';
import energyStarBadge from '../../assets/images/badges/energy-star.png';
import equalHousingBadge from '../../assets/images/badges/equal-housing-lender.png';
import { Image } from 'astro:assets';

const featuredSlugs = new Map(cityPages.map((c) => [c.name, c.slug]));
const categories: ServiceCategory[] = ['plumbing', 'hvac', 'electrical', 'sewer'];
const trustBadges = [
  { name: 'Energy Star Partner', image: energyStarBadge },
  { name: 'Equal Housing Lender', image: equalHousingBadge }
];

const year = new Date().getFullYear();
const companyLinks = [
  { label: 'Our Services', href: '/services/' },
  { label: 'Service Area', href: '/service-area/' },
  { label: 'Financing', href: '/financing/' },
  { label: 'Coupons', href: '/coupons/' },
  { label: 'Careers', href: '/careers/' },
  { label: 'Blog', href: '/blog/' },
  { label: 'Contact Us', href: '/contact-us/' },
  { label: 'Accessibility', href: '/accessibility/' },
  { label: 'Privacy Policy', href: '/privacy-policy/' }
];
---

<footer class="bg-navy-900 text-white/60">
  <!-- Closing CTA -->
  <div class="border-b border-white/10 bg-white">
    <Container class="flex flex-col items-center gap-6 py-14 text-center sm:py-16">
      <h2 class="font-display text-ink-900 text-3xl font-bold text-balance sm:text-4xl">
        One call does it all. Let&rsquo;s fix it today.
      </h2>
      <p class="text-ink-500 max-w-xl text-balance">
        Licensed, insured technicians on call 24/7 across Colorado Springs and the surrounding area.
      </p>
      <div class="flex flex-col gap-3 sm:flex-row">
        <Button href="/contact-us/" size="lg">Request Service</Button>
        <Button href={`tel:${business.hotline.tel}`} variant="secondary" size="lg">
          Call {business.hotline.display}
        </Button>
      </div>
    </Container>
  </div>

  <Container class="grid grid-cols-2 gap-x-8 gap-y-12 py-16 sm:grid-cols-2 lg:grid-cols-[1.3fr_1fr_1fr_1.1fr]">
    <div class="col-span-2 lg:col-span-1">
      <a href="/" aria-label={`${business.name} - Home`}>
        <Image src={logo} alt={business.name} width={190} height={80} densities={[1, 2]} quality="max" class="h-10 w-auto" />
      </a>
      <p class="mt-4 max-w-xs text-sm leading-relaxed text-white/60">
        Colorado Springs' trusted plumbing, heating, cooling &amp; electrical company. Honest pricing, licensed
        technicians, available 24/7.
      </p>
      <div class="mt-5 flex items-center gap-2.5">
        <SocialIcon network="facebook" href={business.social.facebook} />
      </div>
      <div class="mt-6 flex items-center gap-4">
        {
          trustBadges.map((badge) => (
            <Image src={badge.image} alt={badge.name} width={100} height={42} class="h-10 w-auto rounded bg-white/95 p-1" loading="lazy" />
          ))
        }
      </div>
    </div>

    <div>
      <h3 class="font-display text-sm font-bold tracking-wider text-white uppercase">Services</h3>
      {
        categories.map((cat) => (
          <div class="mt-4">
            <p class="text-xs font-semibold tracking-wide text-white/40 uppercase">{categoryMeta[cat].label}</p>
            <ul class="mt-2 space-y-2">
              {services
                .filter((s) => s.category === cat)
                .slice(0, 4)
                .map((s) => (
                  <li>
                    <a href={`/services/${s.slug}/`} class="text-sm text-white/60 transition-colors hover:text-orange-400">
                      {s.title}
                    </a>
                  </li>
                ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div>
      <h3 class="font-display text-sm font-bold tracking-wider text-white uppercase">Company</h3>
      <ul class="mt-4 space-y-2.5">
        {
          companyLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-white/60 transition-colors hover:text-orange-400">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="col-span-2 sm:col-span-1">
      <h3 class="font-display text-sm font-bold tracking-wider text-white uppercase">Get In Touch</h3>
      <ul class="mt-4 space-y-3 text-sm">
        <li>
          <a href={`tel:${business.hotline.tel}`} class="flex items-center gap-1.5 font-semibold text-white hover:text-orange-400">
            <Phone className="size-3.5 text-orange-400" aria-hidden="true" />
            {business.hotline.display}
          </a>
        </li>
        <li>
          <a href={`mailto:${business.email}`} class="flex items-center gap-1.5 text-white/60 hover:text-orange-400">
            <Mail className="size-3.5 text-orange-400" aria-hidden="true" />
            {business.email}
          </a>
        </li>
      </ul>
      <p class="mt-4 flex items-center gap-1.5 text-sm text-white/60">
        <Clock className="size-3.5 text-orange-400" aria-hidden="true" />
        {business.hours}
      </p>
      <p class="mt-1.5 flex items-start gap-1.5 text-sm text-white/60">
        <MapPin className="mt-0.5 size-3.5 shrink-0 text-orange-400" aria-hidden="true" />
        {business.streetAddress}, {business.addressLocality}, {business.addressRegion} {business.postalCode}
      </p>
    </div>
  </Container>

  <!-- Service area -->
  <div class="border-t border-white/5 py-10">
    <Container>
      <p class="font-display text-center text-sm font-bold tracking-wider text-white/70 uppercase">
        Proudly Serving Colorado Springs &amp; the Surrounding Area
      </p>
      <ul class="mx-auto mt-5 flex max-w-4xl flex-wrap justify-center gap-x-5 gap-y-2.5">
        {
          serviceAreas.map((area) => {
            const slug = featuredSlugs.get(area.name);
            return (
              <li class="text-xs text-white/60">
                <a href={slug ? `/service-area/${slug}/` : '/service-area/'} class="transition-colors hover:text-orange-400">
                  {area.name}
                </a>
              </li>
            );
          })
        }
      </ul>
      <div class="mt-5 flex justify-center">
        <a href="/service-area/" class="inline-flex items-center gap-1 text-xs font-semibold text-orange-300 hover:text-orange-200">
          View full service area <ArrowRight className="size-3.5" aria-hidden="true" />
        </a>
      </div>
    </Container>
  </div>

  <div class="border-t border-white/5 py-6">
    <Container class="flex flex-col items-center gap-2 text-center text-xs text-white/60 sm:flex-row sm:justify-between sm:text-left">
      <p>&copy; {year} {business.legalName}. All rights reserved.</p>
      <p>
        License #{business.license.electrical} &nbsp;·&nbsp; License #{business.license.plumbing} &nbsp;·&nbsp; License #{
          business.license.mechanical
        }
      </p>
    </Container>
  </div>
</footer>
