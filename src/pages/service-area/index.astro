---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import ServiceAreaMap from '../../components/sections/ServiceAreaMap.astro';
import ContactCTA from '../../components/sections/ContactCTA.astro';
import Container from '../../components/ui/Container.astro';
import Button from '../../components/ui/Button.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import { CircleCheck, Phone } from 'lucide-react';
import { business, surroundingServiceAreas } from '../../data/business';
import heroImage from '../../assets/images/hero/castle-rock-aerial.jpg';
import { buildBreadcrumbSchema } from '../../lib/schema';

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Home', path: '/' },
  { name: 'Service Area', path: '/service-area/' }
]);

const trustPoints = [
  'Licensed and insured for plumbing, electrical & mechanical work',
  'Available 24 hours a day, 7 days a week',
  'The same trusted crew across every community we serve'
];
---

<BaseLayout
  title={`Service Area | Plumbing, HVAC & Electrical Near Colorado Springs, CO`}
  description={`Affordable Plumbing, Heat & Electrical serves Colorado Springs and ${surroundingServiceAreas.length} surrounding Colorado communities, including Castle Rock, Falcon, Fountain, Monument, and Woodland Park.`}
  schema={[breadcrumbSchema]}
>
  <PageHero
    title="Service Area for Plumbing, HVAC & Electrical Services"
    description="Colorado Springs and select surrounding Colorado communities. If you're nearby, we can help."
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Service Area' }]}
    image={heroImage}
    imageAlt="Aerial view of the Colorado Springs region"
  />

  <section class="bg-white py-16 sm:py-20">
    <Container class="mx-auto max-w-3xl text-center" data-reveal>
      <Eyebrow>Local Coverage</Eyebrow>
      <h2 class="font-display text-ink-900 mt-4 text-3xl leading-[1.1] font-bold text-balance sm:text-4xl">
        Serving Colorado Springs &amp; Surrounding Colorado Communities
      </h2>
      <p class="text-ink-600 mx-auto mt-5 max-w-2xl leading-relaxed text-balance">
        We proudly serve our community with top-notch plumbing, heating, cooling, electrical, and sewer solutions that
        combine quality workmanship with unbeatable value. Colorado Springs is our home base and primary market, and we
        extend the same 24/7, licensed service to {surroundingServiceAreas.length} verified surrounding communities across
        the Pikes Peak region and beyond. Whether you need emergency repairs, routine maintenance, or expert installations,
        we&rsquo;re here to help.
      </p>
      <ul class="mx-auto mt-8 flex max-w-xl flex-col gap-3 text-left sm:mx-0">
        {
          trustPoints.map((item) => (
            <li class="text-ink-700 flex items-start gap-3 text-sm">
              <CircleCheck className="mt-0.5 size-4 shrink-0 text-orange-600" aria-hidden="true" />
              {item}
            </li>
          ))
        }
      </ul>
      <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
        <Button href="/contact-us/" size="lg">Get a Free Estimate</Button>
        <Button href={`tel:${business.hotline.tel}`} variant="outline" size="lg" icon={Phone}>
          {business.hotline.display}
        </Button>
      </div>
    </Container>
  </section>

  <!-- Premium interactive Colorado service-area map: markers, legend, compass,
       coverage-area hull, and a crawlable "Communities We Serve" side panel
       that's the primary a11y/SEO redundancy for the visual map. -->
  <section class="border-ink-100 border-t bg-mist-100 py-16 sm:py-20">
    <Container>
      <div class="mx-auto max-w-2xl text-center" data-reveal>
        <Eyebrow>Where We Work</Eyebrow>
        <h2 class="font-display text-ink-900 mt-4 text-2xl font-bold sm:text-3xl">Our Colorado Service Footprint</h2>
        <p class="text-ink-500 mt-3">
          Colorado Springs is our primary market. Hover or tap a marker to see coverage details for surrounding
          communities.
        </p>
      </div>
      <div class="mx-auto mt-10 w-full">
        <ServiceAreaMap variant="full" />
      </div>
      <p class="text-ink-400 mt-8 flex items-center justify-center gap-1.5 text-center text-xs">
        <Phone className="size-3.5 shrink-0" aria-hidden="true" />
        Don&rsquo;t see your town? Call {business.hotline.display} — there&rsquo;s a good chance we still cover you
        (serving {surroundingServiceAreas.length} verified surrounding communities today).
      </p>
    </Container>
  </section>

  <ContactCTA
    title="Need Service in Your Area?"
    description="Reach out today, we'll confirm coverage for your address and get a technician on the way."
  />
</BaseLayout>
