---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import Container from '../../components/ui/Container.astro';
import Button from '../../components/ui/Button.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import { CircleCheck, Phone, MapPin } from 'lucide-react';
import { business, serviceAreas } from '../../data/business';
import { cityPages } from '../../data/cityPages';
import heroImage from '../../assets/images/hero/castle-rock-aerial.jpg';
import { buildBreadcrumbSchema } from '../../lib/schema';

const featuredSlugs = new Map(cityPages.map((c) => [c.name, c.slug]));

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Home', path: '/' },
  { name: 'Service Area', path: '/service-area/' }
]);

const trustPoints = [
  'Licensed and insured for plumbing, electrical & mechanical work',
  'Available 24 hours a day, 7 days a week',
  'The same trusted crew across every community we serve'
];
---

<BaseLayout
  title={`Service Area | Plumbing, HVAC & Electrical Near Colorado Springs, CO`}
  description="Affordable Plumbing, Heat & Electrical serves Colorado Springs and the surrounding Pikes Peak region, including Castle Rock, Falcon, Fountain, Monument, and Woodland Park."
  schema={[breadcrumbSchema]}
>
  <PageHero
    title="Service Area for Plumbing, HVAC & Electrical Services"
    description="Colorado Springs and the surrounding area. If you're nearby, we can help."
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Service Area' }]}
    image={heroImage}
    imageAlt="Aerial view of the Colorado Springs region"
  />

  <section class="bg-white py-16 sm:py-24">
    <Container class="grid items-center gap-14 lg:grid-cols-2 lg:gap-16">
      <div data-reveal="left">
        <Eyebrow>Local Coverage</Eyebrow>
        <h2 class="font-display text-ink-900 mt-4 text-3xl leading-[1.1] font-bold text-balance sm:text-4xl">
          Quality Heating, Cooling & Electrical from Colorado Springs to the Surrounding Area
        </h2>
        <p class="text-ink-600 mt-5 max-w-lg leading-relaxed text-balance">
          We proudly serve our community with top-notch plumbing, heating, and electrical solutions that combine
          quality workmanship with unbeatable value. Whether you need emergency repairs, routine maintenance, or
          expert installations, we're here to help.
        </p>
        <ul class="mt-8 flex flex-col gap-3">
          {
            trustPoints.map((item) => (
              <li class="text-ink-700 flex items-start gap-3 text-sm">
                <CircleCheck className="mt-0.5 size-4 shrink-0 text-orange-600" aria-hidden="true" />
                {item}
              </li>
            ))
          }
        </ul>
        <div class="mt-9 flex flex-wrap gap-3">
          <Button href="/contact-us/" size="lg">Get a Free Estimate</Button>
          <Button href={`tel:${business.hotline.tel}`} variant="outline" size="lg" icon={Phone}>
            {business.hotline.display}
          </Button>
        </div>
      </div>

      <div class="card-elevated overflow-hidden p-0" data-reveal="right">
        <iframe
          title={`Map of ${business.name} service area`}
          src={`https://maps.google.com/maps?q=${encodeURIComponent(`${business.streetAddress}, ${business.addressLocality}, ${business.addressRegion} ${business.postalCode}`)}&z=9&output=embed`}
          class="h-[380px] w-full border-0 sm:h-[440px]"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </Container>
  </section>

  <section class="border-ink-100 border-t bg-mist-100 pb-20 sm:pb-28">
    <Container class="mx-auto max-w-4xl pt-16 text-center" data-reveal>
      <h2 class="font-display text-ink-900 text-2xl font-bold sm:text-3xl">Communities We Serve</h2>
      <p class="text-ink-500 mx-auto mt-3 max-w-lg">
        Don't see your community listed? Give us a call anyway, there's a good chance we still cover you.
      </p>
      <ul class="mx-auto mt-10 grid max-w-3xl grid-cols-2 gap-x-6 gap-y-3 text-left sm:grid-cols-3 md:grid-cols-4">
        {
          serviceAreas.map((area) => {
            const slug = featuredSlugs.get(area.name);
            return (
              <li class="border-ink-100 text-ink-700 shadow-card flex items-center gap-2 rounded-xl border bg-white px-4 py-2.5 text-sm">
                <MapPin className="size-3.5 shrink-0 text-orange-500" aria-hidden="true" />
                {slug ? (
                  <a href={`/service-area/${slug}/`} class="transition-colors hover:text-orange-600">
                    {area.name}
                  </a>
                ) : (
                  area.name
                )}
              </li>
            );
          })
        }
      </ul>
      <div class="mt-12 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
        <Button href="/contact-us/" size="lg">Get a Free Estimate</Button>
        <Button href={`tel:${business.hotline.tel}`} variant="outline" size="lg" icon={Phone}>
          {business.hotline.display}
        </Button>
      </div>
    </Container>
  </section>
</BaseLayout>
